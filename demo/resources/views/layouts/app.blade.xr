<!DOCTYPE html>
<html lang="en">

@globals
    title = "Larust - ship with confidence"
    canonical = "/"
@endglobals

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4513d">
    <meta name="view-transition" content="same-origin">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml"/>
    <title>@global(title, "Larust")</title>
    <link rel="canonical" href="@global(canonical, "/")">
    @stack('head')
    <script>
        (function() {
            try {
                var t = localStorage.getItem('larust-theme');
                document.documentElement.dataset.theme = t || (matchMedia('(prefers-color-scheme: dark)').matches ?
                    'dark' : 'light')
            } catch (_) {}
        })()
    </script>
    <link rel="stylesheet" href="/styles/style.min.css">
    
</head>

<body>
    <header class="site-header">
        <a class="brand" href="/">
            <span class="brand-mark">&gt;_</span>
            <span>larust</span>
        </a>
