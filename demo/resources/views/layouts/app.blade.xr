<!DOCTYPE html>
<html lang="en" data-theme="@global(theme, "dark")">

@globals
    title = "Larust - ship with confidence"
    canonical = "/"
    persist theme = "dark"
@endglobals

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4513d">
    <meta name="view-transition" content="same-origin">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml"/>
    <title>@global(title, "Larust")</title>
    <link rel="canonical" href="@global(canonical, "/")">
    @stack('head')
    <link rel="stylesheet" href="/styles/style.min.css">

</head>

<body>
    <header class="site-header" id="__larust_spa_header">
        <a class="brand" href="/">
            <span class="brand-mark">&gt;_</span>
            <span>larust</span>
        </a>
        <div class="header-controls">
            <button class="menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false">
                <span class="menu-toggle-label">Menu</span>
                <span class="menu-toggle-icon" aria-hidden="true"><i></i><i></i><i></i></span>
            </button>
        </div>
        <nav class="nav" id="site-navigation" aria-label="Primary navigation">
            <a class="{{ if nav_active == "home" { "nav-link is-active" } else { "nav-link" } }}" href="/">Home</a>
            <a class="{{ if nav_active == "posts" { "nav-link is-active" } else { "nav-link" } }}" href="/posts">Posts</a>
            @if(is_authenticated)
                <a class="{{ if nav_active == "profile" { "nav-link is-active" } else { "nav-link" } }}" href="/profile">Profile</a>
                <form method="POST" action="/logout">
                    @csrf
                    <button class="logout-button" type="submit">Log out</button>
                </form>
                <a class="{{ if nav_active == "create" { "nav-cta is-active" } else { "nav-cta" } }}" href="/posts/create">New Post</a>
            @else
                <a class="{{ if nav_active == "login" { "nav-link is-active" } else { "nav-link" } }}" href="/login">Log in</a>
                <a class="nav-cta" href="/register">Start building</a>
            @endif
            <div class="badge-controls">
                @if(is_authenticated)
                    <button class="notification-toggle" type="button" aria-controls="notification-drawer" aria-expanded="false" aria-label="Open notifications">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
                        @if(unread_count > 0)
                            <span class="notification-badge" data-notification-badge>{{ unread_count }}</span>
                        @endif
                    </button>
                @endif
                <button class="theme-toggle" type="button" aria-label="Toggle color theme">
                    <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                    </svg>
                    <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
                    </svg>
                </button>
            </div>
        </nav>
        <button class="nav-scrim" type="button" aria-label="Close navigation" tabindex="-1"></button>
        @if(is_authenticated)
            <aside class="notification-drawer" id="notification-drawer" aria-labelledby="notification-drawer-title" aria-hidden="true">
                <div class="notification-drawer-content" aria-live="polite">
                    <p class="notification-loading">Loading notifications&hellip;</p>
                </div>
            </aside>
            <button class="notification-scrim" type="button" aria-label="Close notifications" tabindex="-1"></button>
        @endif
    </header>

    @spa
        @yield('content')
    @endspa

    <footer class="site-footer">
        Larust by <a href="https://wallabydesigns.com" class="wallaby" target="_blank" rel="noopener noreferrer">Wallaby Designs</a> ·
        familiar conventions, Rust certainty.
    </footer>
    <script>
        // Fully delegated (listeners live on `document`, never on the
        // `.theme-toggle` button itself) so this keeps working after
        // SPA navigation replaces `#__larust_spa_header`'s content on
        // every page change - a freshly swapped-in button is just as clickable
        // as the original, since `closest()` is re-evaluated per click.
        // The one thing a fresh button DOESN'T carry over from the server
        // render is its `aria-label` (SSR always emits the static default
        // "Toggle color theme" - only this script computes the live,
        // theme-specific label) - `larust:spa:navigated` re-syncs that.
        (function() {
            function ariaLabelFor(theme) {
                return theme === 'dark' ? 'Use light theme' : 'Use dark theme';
            }

            function syncAriaLabel() {
                var b = document.querySelector('.theme-toggle');
                if (!b) return;
                b.setAttribute('aria-label', ariaLabelFor(document.documentElement.dataset.theme));
            }

            document.addEventListener('click', function(event) {
                if (!event.target.closest('.theme-toggle')) return;
                var t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
                document.documentElement.dataset.theme = t;
                // A year-long, unsigned cookie - matches
                // `larust_http::preferences`' own `larust_pref_{name}`
                // naming exactly, so the *next* server render picks this
                // up automatically via `persist theme = "dark"` above.
                // No server round trip for the toggle itself; this is
                // purely so the next page load already renders correctly.
                document.cookie = 'larust_pref_theme=' + t + '; path=/; max-age=31536000; samesite=lax';
                syncAriaLabel();
            });
            document.addEventListener('larust:spa:navigated', syncAriaLabel);
            syncAriaLabel();
        })()
    </script>
    <script>
        // Delegated for the same reason as the theme toggle above - the
        // mobile menu's own button/nav/scrim all live inside
        // `#__larust_spa_header` and get replaced on every SPA
        // navigation. `close()` re-queries the *current* nav/scrim/toggle
        // on every call rather than capturing them once, so the
        // permanent, singleton `keydown`/`matchMedia` listeners below
        // (bound to `document`/a `MediaQueryList`, never replaced) always
        // act on whatever's live in the DOM right now, not a stale,
        // detached reference from before the last header swap.
        (function() {
            function close() {
                var nav = document.querySelector('.nav');
                var scrim = document.querySelector('.nav-scrim');
                var toggle = document.querySelector('.menu-toggle');
                if (!nav || !scrim || !toggle) return;
                nav.classList.remove('is-open');
                scrim.classList.remove('is-visible');
                toggle.setAttribute('aria-expanded', 'false');
                document.body.classList.remove('nav-open');
            }

            function open() {
                var nav = document.querySelector('.nav');
                var scrim = document.querySelector('.nav-scrim');
                var toggle = document.querySelector('.menu-toggle');
                if (!nav || !scrim || !toggle) return;
                nav.classList.add('is-open');
                scrim.classList.add('is-visible');
                toggle.setAttribute('aria-expanded', 'true');
                document.body.classList.add('nav-open');
            }

            document.addEventListener('click', function(event) {
                if (event.target.closest('.menu-toggle')) {
                    var nav = document.querySelector('.nav');
                    nav && nav.classList.contains('is-open') ? close() : open();
                    return;
                }
                if (event.target.closest('.nav-scrim')) {
                    close();
                    return;
                }
                if (event.target.closest('.nav a, .nav .logout-button')) {
                    close();
                }
            });
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') close();
            });
            matchMedia('(min-width: 681px)').addEventListener('change', function(event) {
                if (event.matches) close();
            });
        })()
    </script>
    <script>
        // Delegated for the same reason as the two scripts above - plus a
        // second, independent bug this fixes: the old version's top-level
        // `if (!toggle || !drawer || !scrim || !content) return;` guard
        // meant a session that started logged OUT (so none of these
        // auth-conditional elements exist yet) would permanently
        // disable this whole feature, even after a later SPA-navigated
        // login made them appear - the script only ever ran once, at
        // initial page load. Delegation sidesteps that entirely: every
        // element is re-queried at the moment it's needed, so it doesn't
        // matter whether it existed yet when this script first ran. The
        // unread badge itself needs no client-side re-sync after a header
        // swap - it's server-rendered fresh into the nav on every
        // request, same as the rest of `#__larust_spa_header`.
        (function() {
            function syncBadge() {
                var content = document.querySelector('.notification-drawer-content');
                var badge = document.querySelector('[data-notification-badge]');
                if (!content || !badge) return;
                var summary = content.querySelector('[data-unread-count]');
                var count = summary ? Number(summary.dataset.unreadCount) : 0;
                badge.textContent = count;
                badge.hidden = count === 0;
            }

            function close() {
                var drawer = document.querySelector('.notification-drawer');
                var scrim = document.querySelector('.notification-scrim');
                var toggle = document.querySelector('.notification-toggle');
                if (!drawer || !scrim || !toggle) return;
                drawer.classList.remove('is-open');
                scrim.classList.remove('is-visible');
                drawer.setAttribute('aria-hidden', 'true');
                toggle.setAttribute('aria-expanded', 'false');
                document.body.classList.remove('notification-drawer-open');
            }

            function load() {
                var content = document.querySelector('.notification-drawer-content');
                if (!content) return Promise.resolve();
                content.setAttribute('aria-busy', 'true');
                return fetch('/notifications/drawer', { credentials: 'same-origin' })
                    .then(function(response) { return response.text(); })
                    .then(function(html) {
                        var current = document.querySelector('.notification-drawer-content');
                        if (!current) return;
                        current.innerHTML = html;
                        current.removeAttribute('aria-busy');
                        syncBadge();
                    });
            }

            function open() {
                var drawer = document.querySelector('.notification-drawer');
                var scrim = document.querySelector('.notification-scrim');
                var toggle = document.querySelector('.notification-toggle');
                if (!drawer || !scrim || !toggle) return;
                drawer.classList.add('is-open');
                scrim.classList.add('is-visible');
                drawer.setAttribute('aria-hidden', 'false');
                toggle.setAttribute('aria-expanded', 'true');
                document.body.classList.add('notification-drawer-open');
                load();
            }

            document.addEventListener('click', function(event) {
                if (event.target.closest('.notification-toggle')) {
                    var drawer = document.querySelector('.notification-drawer');
                    drawer && drawer.classList.contains('is-open') ? close() : open();
                    return;
                }
                if (event.target.closest('.notification-scrim')) {
                    close();
                }
            });
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') close();
            });
            document.addEventListener('submit', function(event) {
                var content = document.querySelector('.notification-drawer-content');
                if (!content || !content.contains(event.target)) return;
                var form = event.target.closest('form');
                if (!form) return;
                event.preventDefault();
                var csrf = document.querySelector('meta[name="csrf-token"]');
                // URLSearchParams, not a raw FormData - see the comment
                // form's own fetch (posts/show.blade.xr) for why a
                // multipart body silently breaks url-encoded field
                // decoding; these forms have no fields today besides the
                // CSRF token, but there's no reason to leave the same
                // trap set for whoever adds one later.
                fetch(form.action, {
                    method: 'POST',
                    body: new URLSearchParams(new FormData(form)),
                    credentials: 'same-origin',
                    headers: csrf ? { 'X-CSRF-TOKEN': csrf.content } : {}
                })
                    .then(function() { return load(); });
            });
        })()
    </script>

    @larustscripts
</body>

</html>
