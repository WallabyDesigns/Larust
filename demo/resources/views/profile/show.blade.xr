        <resource:components.panel title="Your profile." subtitle="Keep your name and email address up to date." extra_class="">
            <form method="POST" action="/profile">
                @csrf
                <div class="field">
                    <label for="name">Your name</label>
                    <input id="name" type="text" name="name" value="{{ name }}" required>
                </div>
                <div class="field">
                    <label for="email">Email address</label>
                    <input id="email" type="email" name="email" value="{{ email }}" required>
                </div>
                <button class="button" type="submit">Save profile <span>&rarr;</span></button>
            </form>
        </resource:components.panel>
        <resource:components.panel title="Change password." subtitle="Use a password you don't use anywhere else." extra_class="gap-top">
            <form method="POST" action="/profile/password">
                @csrf
                <div class="field">
                    <label for="current_password">Current password</label>
                    <input id="current_password" type="password" name="current_password" required>
                </div>
                <div class="field">
                    <label for="password">New password</label>
                    <input id="password" type="password" name="password" placeholder="At least 8 characters" required>
                </div>
                <div class="field">
                    <label for="password-confirmation">Confirm new password</label>
                    <input id="password-confirmation" type="password" name="password_confirmation" placeholder="Repeat your new password" required>
                </div>
                <button class="button" type="submit">Update password <span>&rarr;</span></button>
            </form>
        </resource:components.panel>
