<div class="notification-drawer-header">
    <div>
        <p class="notification-drawer-eyebrow">{{ larust_support::lang::t("notifications.eyebrow") }}</p>
        <h2 id="notification-drawer-title">{{ larust_support::lang::t("notifications.heading") }}</h2>
    </div>
    @if(total_count > 0)
        <form method="POST" action="/notifications/clear-all">
            @csrf
            <button class="notification-clear-all" type="submit">{{ larust_support::lang::t("notifications.clear_all") }}</button>
        </form>
    @endif
</div>

@if(total_count > 0)
    <p class="notification-summary" data-unread-count="{{ unread_count }}">{{ larust_support::lang::t_with("notifications.unread_count", &[("count", &unread_count.to_string())]) }}</p>
    <div class="notification-list">
        @foreach(notification in notifications)
            <article class="notification-drawer-item {{ if notification.is_unread { "is-unread" } else { "" } }}">
                <p>{{ notification.message }}</p>
                <div class="notification-item-actions">
                    <a href="/posts/{{ notification.post_id }}">{{ larust_support::lang::t("notifications.view_post") }}</a>
                    <form method="POST" action="/notifications/{{ notification.id }}/clear">
                        @csrf
                        <button type="submit" aria-label="{{ larust_support::lang::t("notifications.clear_notification_aria") }}">{{ larust_support::lang::t("posts.clear") }}</button>
                    </form>
                </div>
            </article>
        @endforeach
    </div>
@else
    <div class="notification-empty">
        <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
            <p>{{ larust_support::lang::t("notifications.all_caught_up") }}</p>
        </div>
    </div>
@endif
