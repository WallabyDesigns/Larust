<div class="post-list-search">
    <input 
        type="text" 
        wire:model.live="query" 
        value="{{ query }}" 
        placeholder="Filter by title&hellip;"
        aria-label="Filter posts by title">
    @if(!query.is_empty())
        <button type="button" wire:click="clear_search">Clear</button>
    @endif
</div>
<p class="post-count">{{ post_count }} posts</p>
<section class="post-grid">
    @foreach((post, loop_) in posts.iter().with_loop())
        <article class="post-card">
            <div>
                <span class="post-index">#{{ loop_.iteration }}{{ if loop_.first { " · Latest" } else { "" } }}</span>
                <h2 class="post-title"><a href="/posts/{{ post.id }}">{{ post.title }}</a></h2>
                <p class="post-meta">By {{ post.author_name }}</p>
            </div>
            <div class="tag-line">
                {{ post.tag_names }}
            </div>
            @if(post.can_manage)
                <div class="post-actions">
                    <a href="/posts/{{ post.id }}/edit">Edit</a>
                    <form method="POST" action="/posts/{{ post.id }}/delete">
                        @csrf<button type="submit">Delete</button>
                    </form>
                </div>
            @endif
        </article>
    @endforeach
    @if(post_count == 0 && !query.is_empty())
        <p class="search-empty">No posts match "{{ query }}".</p>
    @elseif(post_count == 0 && query.is_empty())
        <p class="search-empty">No posts yet.</p>
    @endif
</section>
