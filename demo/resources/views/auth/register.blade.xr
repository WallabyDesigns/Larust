@extends('layouts.app')

@globals
    title = "Register | Larust - ship with confidence"
    cannonical = "/register"
@endglobals

@section('content')
    <main class="page-narrow">
        <section class="form-card">
            <h1>Build your next thing.</h1>
            <p>One account, a clean place to begin.</p>
            @if(!flash_error.is_empty())
                <p class="flash-error">{{ flash_error }}</p>
            @endif
            <form method="POST" action="/register">
                @csrf
                <div class="field">
                    <label for="name">Your name</label>
                    <input id="name" type="text" name="name" placeholder="Ada Lovelace" required>
                </div>
                <div class="field">
                    <label for="email">Email address</label>
                    <input id="email" type="email" name="email" placeholder="ada@example.com" required>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <input id="password" type="password" name="password" placeholder="At least 8 characters" required>
                </div>
                <div class="field">
                    <label for="password-confirmation">Confirm password</label>
                    <input id="password-confirmation" type="password" name="password_confirmation" placeholder="Repeat your password" required>
                </div>
                <button class="button" type="submit">Create account <span>&rarr;</span></button>
            </form>
            <p class="form-footer">Already have an account? <a href="/login">Log in</a></p>
        </section>
    </main>
    <script>
        // Real consumer of the SPA-navigation runtime's validation-error
        // event (crates/larust-spa/assets/spa-runtime.js) - this form's
        // own required/type=email attributes already stop an empty or
        // malformed submission client-side, but "password" and
        // "password_confirmation" matching isn't something a browser can
        // validate natively, so a real 422 (from #[validate(confirmed)])
        // is easy to reach here: mistype the confirmation field.
        //
        // This script re-executes on every SPA navigation INTO this page
        // (see spa-runtime.js's own executeScripts) as a fresh closure
        // each time, so `window.__registerValidationListenerBound` guards
        // against binding a second, duplicate document-level listener on
        // a later re-navigation to this same page.
        if (!window.__registerValidationListenerBound) {
            window.__registerValidationListenerBound = true;
            document.addEventListener('larust:spa:validation-error', function(event) {
                var card = document.querySelector('.form-card');
                if (!card) return;
                var existing = card.querySelector('.flash-error');
                if (existing) existing.remove();

                var messages = [];
                var errors = event.detail.errors || {};
                Object.keys(errors).forEach(function(field) {
                    errors[field].forEach(function(message) { messages.push(message); });
                });
                if (messages.length === 0) return;

                var flash = document.createElement('p');
                flash.className = 'flash-error';
                flash.textContent = messages.join(' ');
                card.insertBefore(flash, card.querySelector('form'));
            });
        }
    </script>
@endsection
