APP_NAME="Larust Dashboard"
APP_ENV=local
APP_PORT=8000
# Which named connection below is active — sqlite, mysql, mariadb, pgsql, or
# sqlsrv (see config/database.rs). sqlsrv isn't connectable via this
# framework's ORM at all — see the larust-mssql crate.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=larust
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# Base URL used by url()/asset() to build absolute URLs from a relative path.
APP_URL=http://localhost:8000
# Browsers only treat loopback/`localhost` as a secure context over plain HTTP.
# Set this to false if you serve local dev from a custom hostname (e.g. a .test
# domain in /etc/hosts) or the session cookie will be silently dropped.
SESSION_SECURE_COOKIE=true
# Renders full error detail (message, source chain, panics) as an HTML page
# instead of a generic "internal server error". Never enable outside local dev.
APP_DEBUG=true
# "log" writes a mail's rendered subject/body to the app's own log output
# instead of sending it — no SMTP server needed for local dev or `cargo test`.
# Set this to "smtp" and fill in the fields below to send for real.


MAIL_DRIVER=log
MAIL_MAILER=log
# MAIL_HOST='mail.example.com'
# MAIL_PORT="465"
# MAIL_USERNAME="mail@example.com"
# MAIL_PASSWORD='password'
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS="mail@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# "database" stores cache/queue entries in the same connection
# DB_CONNECTION selects above; "redis" uses Redis instead (REDIS_URL,
# default redis://127.0.0.1:6379).
# CACHE_DRIVER=database
# QUEUE_DRIVER=database
# REDIS_URL=redis://127.0.0.1:6379

# Blog-specific settings (`config/blog.rs`) — not part of the fixed
# `larust_core::Config` struct, read via the generated-style per-file
# config pattern instead (see `larust_convert::config`'s doc comment).
# BLOG_POSTS_PER_PAGE=25
# BLOG_NOTIFICATIONS_PER_PAGE=20

# larust-db's database admin dashboard — browse/edit this app's real SQL
# database (Database + SQL tabs) plus the embedded KV store (KV tab). See
# docs/ARCHITECTURE.md's "Database admin dashboard and embedded key-value
# store" section. Refuses to serve at all if the password is unset (fail
# closed) — set both to enable it locally. Also gated behind APP_DEBUG=true
# above, so it's never reachable in a production deployment that leaves
# that at its default.
# DB_DASHBOARD_PASSWORD=
# Mount path — defaults to xr-db (i.e. /xr-db) when unset.
# DB_DASHBOARD_PATH=xr-db