{
  "comments": {
    "blockComment": ["{{--", "--}}"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*@(if|elseif|foreach|section|globals|push|live|can|role|spa|loadonce|code)\\b|<resource:[A-Za-z0-9_.]+[^>]*(?<!/)>\\s*$",
    "decreaseIndentPattern": "^\\s*(@(else|elseif|endif|endforeach|endsection|endglobals|endpush|endlive|endcan|endrole|endspa|endloadonce|endcode)\\b|</resource:[A-Za-z0-9_.]+>)"
  }
}
